{
  "name": "pc-forge",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "json-server-auth server/db.json --port 3030 -r server/routes.json",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "db:reset": "node -e \"require('fs').copyFileSync('server/db.seed.json','server/db.json')\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "json-server": "^0.17.4",
    "json-server-auth": "^2.1.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
